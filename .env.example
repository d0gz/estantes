# Copie para .env (que está no .gitignore) e preencha. Nunca commite o .env.
#
# Painel do Supabase → botão "Connect" → "Session pooler" (IPv4, porta 5432).
# Troque [YOUR-PASSWORD] pela senha do banco definida ao criar o projeto.
SUPABASE_DB_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
